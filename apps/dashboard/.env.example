# The only browser-visible configuration. Secrets belong in apps/worker or Laravel.
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_USE_PROXY=false
NEXT_PUBLIC_AUTH_DRIVER=sanctum
# Server-only. Used exclusively by the optional Next.js proxy; never prefix with NEXT_PUBLIC_.
API_INTERNAL_URL=http://nginx/api
# Safe browser key; secret and webhook keys must only be configured in Laravel.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Storage credentials are intentionally server/worker-only. Never add MEDIA_S3_* here.
